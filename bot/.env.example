# BotFather'dan olingan token (@poshxurt_savdo_bot)
BOT_TOKEN=123456789:AAH...

# Supabase loyiha sozlamalari (Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co

# DIQQAT: bu yerda anon emas, SERVICE_ROLE kalit ishlatiladi!
# (bot serverda ishlaydi, RLS'ni chetlab o'tib yozish uchun)
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Web App manzili (deploy qilingach Vercel/Netlify URL'i)
# Lokal test uchun: ngrok yoki deploy qilingan https manzil bo'lishi shart
WEBAPP_URL=https://your-app.vercel.app
